generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONSULTANT
  ADMIN
}

enum PrivacyMode {
  PUBLIC
  PROTECTED
  PSEUDONYM
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  MORE_INFO_REQUIRED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  APPROVED
  REFUNDED
  FAILED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  twoFactorEnabled    Boolean  @default(false)
  twoFactorSecret     String?
  twoFactorRecoveryCodes String[] @default([])
  twoFactorSetupSecret String?
  twoFactorSetupExpiresAt DateTime?
  failedLoginAttempts  Int      @default(0)
  lastFailedLoginAt    DateTime?
  lockedUntil          DateTime?
  role                Role     @default(USER)
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  professionalProfile  ProfessionalProfile?
  customerBookings     Booking[]              @relation("CustomerBookings")
  favorites            Favorite[]
  reviews              Review[]
  sentMessages         Message[]
  reports              Report[]               @relation("ReportAuthor")
  reportsAgainst       Report[]               @relation("ReportTarget")
  notifications        Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  sector      String
  description String
  logoText    String
  color       String
  location    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiences EmploymentExperience[]
}

model Profession {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  accent      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiences EmploymentExperience[]
  realityCheck RealityCheck?
}

model ProfessionalProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  headline             String
  bio                  String
  location             String
  region               String
  workMode             WorkMode
  seniority            Seniority
  yearsExperience      Int
  price30Cents          Int
  price60Cents          Int
  pixKey                String?
  responseHours        Int                @default(12)
  privacyMode          PrivacyMode        @default(PROTECTED)
  pseudonym            String?
  avatarSeed           String
  topics               String[]
  boundaries           String[]
  verificationStatus   VerificationStatus @default(NOT_SUBMITTED)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacy        PrivacySettings?
  experiences    EmploymentExperience[]
  availability   Availability[]
  bookings       Booking[]
  reviews        Review[]
  favorites      Favorite[]
  verifications  Verification[]
  profileViews   ProfileView[]
}

model PrivacySettings {
  id                      String   @id @default(cuid())
  professionalProfileId   String   @unique
  showRealName            Boolean  @default(false)
  showSurname             Boolean  @default(false)
  showPhoto               Boolean  @default(false)
  showCurrentCompany      Boolean  @default(true)
  showCity                Boolean  @default(false)
  showExactDates          Boolean  @default(false)
  showFullHistory         Boolean  @default(false)
  searchableByCompany     Boolean  @default(true)
  searchableByProfession  Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
}

model EmploymentExperience {
  id                    String    @id @default(cuid())
  professionalProfileId String
  companyId             String
  professionId          String
  title                 String
  area                  String
  isCurrent             Boolean   @default(false)
  startedAt             DateTime
  endedAt               DateTime?
  summary               String
  createdAt             DateTime  @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profession          Profession          @relation(fields: [professionId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([professionId])
  @@index([professionalProfileId])
}

model Availability {
  id                    String   @id @default(cuid())
  professionalProfileId String
  startsAt              DateTime
  endsAt                DateTime
  isBooked               Boolean  @default(false)
  createdAt              DateTime @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  booking            Booking?

  @@index([professionalProfileId, startsAt])
}

model Booking {
  id                    String        @id @default(cuid())
  customerId            String
  professionalProfileId String
  availabilityId        String?       @unique
  startsAt              DateTime
  durationMinutes       Int
  topics                String[]
  goals                 String
  status                BookingStatus @default(PENDING_PAYMENT)
  subtotalCents         Int
  feeCents              Int
  totalCents            Int
  meetingProvider       String        @default("GOOGLE_MEET")
  meetingUrl            String?
  customerRecordingConsent   Boolean  @default(false)
  consultantRecordingConsent Boolean  @default(false)
  customerJoinedAt      DateTime?
  consultantJoinedAt    DateTime?
  meetingEndedAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer           User                @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  professional       ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  availability       Availability?       @relation(fields: [availabilityId], references: [id], onDelete: SetNull)
  payment            Payment?
  review             Review?
  conversation       Conversation?
  reports            Report[]

  @@index([customerId, startsAt])
  @@index([professionalProfileId, startsAt])
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  status      PaymentStatus @default(PENDING)
  amountCents Int
  provider    String        @default("SIMULATED")
  providerRef String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id                    String   @id @default(cuid())
  userId                String
  professionalProfileId String
  createdAt             DateTime @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalProfileId])
}

model Review {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  userId                String
  professionalProfileId String
  rating                Int
  clarity               Int
  usefulness            Int
  contextualization     Int
  comment               String?
  createdAt             DateTime @default(now())

  booking             Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId])
}

model Conversation {
  id        String   @id @default(cuid())
  bookingId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Verification {
  id                    String             @id @default(cuid())
  professionalProfileId String
  method                String
  status                VerificationStatus @default(PENDING)
  adminNotes            String?
  reviewerId            String?
  reviewedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  professionalProfile ProfessionalProfile  @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  documents           VerificationDocument[]

  @@index([status, createdAt])
}

model VerificationDocument {
  id             String   @id @default(cuid())
  verificationId String
  originalName   String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  createdAt      DateTime @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String?
  bookingId    String?
  category     String
  description  String
  status       ReportStatus @default(OPEN)
  resolution   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User     @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

model RealityCheck {
  id           String   @id @default(cuid())
  professionId String   @unique
  title        String
  intro        String
  imagined     String[]
  practical    String[]
  routine      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileView {
  id                    String   @id @default(cuid())
  professionalProfileId String
  viewerHash            String
  viewedAt              DateTime @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, viewedAt])
}
