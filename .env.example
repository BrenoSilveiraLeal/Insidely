DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insidely?schema=public"
AUTH_SECRET="gere-com-openssl-rand-base64-32"
# Chave separada para criptografar o segredo do Google Authenticator.
# Gere com: openssl rand -base64 32. Nunca publique esta chave.
TWO_FACTOR_ENCRYPTION_KEY=""
# Opcional: só configure caso use um monitor interno para /api/health.
HEALTHCHECK_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Never expose SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY in the browser.

# Opcional: armazenamento privado de documentos de verificação.
# Quando ausente, o MVP mantém apenas metadados demonstrativos no banco.
BLOB_READ_WRITE_TOKEN=""

# Login social Google via Supabase (configure no projeto Supabase Auth).
# LinkedIn segue opcional via NextAuth.
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# Futuro: integração de pagamento marketplace e Google Meet. Nunca exponha
# essas chaves com NEXT_PUBLIC_. A versão atual usa pagamento retido simulado.
PAYMENT_PROVIDER=""
PAYMENT_PROVIDER_API_KEY=""
GOOGLE_MEET_ORGANIZER_EMAIL=""
