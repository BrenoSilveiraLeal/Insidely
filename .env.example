NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional legacy PIX email instruction support. The demonstration checkout uses no real key.
PIX_RECEIVER_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=generate-a-long-random-secret
# Optional: leave blank for the simulated checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional advanced image moderation. Local validation remains active without it.
OPENAI_API_KEY=

# Optional Google Meet API integration. The refresh token must be authorized with
# https://www.googleapis.com/auth/meetings.space.created.
GOOGLE_MEET_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Preferred without a custom domain: Gmail SMTP with an app password (myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Insidely <seu-email@gmail.com>
# Alternative: Resend (the sender domain must be verified in Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Insidely <noreply@seu-dominio.com>

# Deterministic authenticated E2E only. Never enable these in production.
E2E_MOCK_EXTERNALS=false
E2E_TRANSFER_MODE=fail-once
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_CONSULTANT_EMAIL=
E2E_CONSULTANT_PASSWORD=
PLAYWRIGHT_PORT=3111
