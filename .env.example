NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_APP_URL=http://localhost:3000
PIX_RECEIVER_KEY=your-platform-pix-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=generate-a-long-random-secret

# Optional advanced image moderation. Local validation remains active without it.
OPENAI_API_KEY=

# Google Calendar/Meet integration remains disabled until OAuth credentials and
# the calendar scope are configured.
GOOGLE_MEET_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
